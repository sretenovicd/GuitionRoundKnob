{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.pio/**": true,
    "**/firmware/.pio/**": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.pio": true,
    "**/firmware/.pio": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "platformio-ide.parallelBuilds": 16,
  "C_Cpp.intelliSenseMemoryLimit": 4096,
  "C_Cpp.enhancedColorization": "enabled"
}
